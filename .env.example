# Never commit real credentials. Cloud configuration is OPTIONAL.
# With no endpoint/key/model, the GUI, cases, PDF/OCR, indexes and local search work.

# Local core
# Windows defaults: %LOCALAPPDATA%/CaseFileAI/data and data/casefile-ai.db.
# Do not uncomment legacy paths unless you deliberately want to keep using them.
# Relative explicit paths resolve beside this configuration file, never against cwd.
# CASEFILE_APP_HOME=C:/Users/your-name/AppData/Local/CaseFileAI
# CASEFILE_DATA_DIR=C:/CaseFileAI/data
# CASEFILE_DATABASE_URL=sqlite:///C:/CaseFileAI/data/casefile-ai.db
CASEFILE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CASEFILE_EMBEDDING_REVISION=4e17e244a0fb63bfb78fca8fcf95079fcc664f5c
CASEFILE_EMBEDDING_DEVICE=cpu
CASEFILE_EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
# OCR uses the installed RapidOCR/ONNX defaults, with local inference.
# First index/search or scanned PDF import may download missing model files.

# Optional cloud model
# Enable ONLY for synthetic or manually de-identified materials (including filenames/questions).
# The application does NOT automatically de-identify evidence.
CASEFILE_LLM_ENABLED=false
CASEFILE_LLM_BASE_URL=
CASEFILE_LLM_API_KEY=
CASEFILE_LLM_MODEL=
# Supply a provider-supported regional endpoint and model when enabling calls.
CASEFILE_LLM_TIMEOUT_SECONDS=60

# Advanced
CASEFILE_LLM_STRUCTURED_OUTPUT_MODE=json_schema
CASEFILE_LLM_MAX_VALIDATION_ATTEMPTS=3
CASEFILE_LOG_LEVEL=INFO
# CASEFILE_LOG_DIR=C:/CaseFileAI/logs
# For a non-default .env, set CASEFILE_ENV_FILE in the process environment before startup.
