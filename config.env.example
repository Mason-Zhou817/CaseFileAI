# CaseFile AI product configuration. Never copy a developer .env automatically.
# Default data/logs/runtime are under %LOCALAPPDATA%/CaseFileAI.
CASEFILE_LLM_ENABLED=false
# Set both paths only when intentionally switching to a verified restore copy:
# CASEFILE_DATA_DIR=C:/Users/your-name/AppData/Local/CaseFileAI/data
# CASEFILE_DATABASE_URL=sqlite:///C:/Users/your-name/AppData/Local/CaseFileAI/data/casefile-ai.db
# Public model calls are only for synthetic or manually de-identified material.
# CASEFILE_LLM_BASE_URL=
# CASEFILE_LLM_MODEL=
# CASEFILE_LLM_API_KEY=
